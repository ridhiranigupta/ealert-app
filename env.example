# ============================================================================
# EAlert — Environment variable checklist
# Copy to .env (never commit .env). All values shown are examples/placeholders.
# Secrets are only ever read server-side (Convex actions); nothing below is
# shipped to the browser.
# ============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Public origin of the deployed app (used for links in alerts/emails).
APP_BASE_URL=https://ealert.example.com

# Regional emergency number surfaced in the SOS flow (tel: link only,
# never auto-dialed). Defaults to 911 if unset.
VITE_EMERGENCY_NUMBER=911

# ---------------------------------------------------------------------------
# Convex (managed by the Convex dashboard; not required in .env locally)
# ---------------------------------------------------------------------------
CONVEX_DEPLOYMENT=prod:your-deployment-name
# Local dev URL (uncomment if running against a remote deployment):
# CONVEX_URL=https://your-project.convex.cloud

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Convex Auth signs session cookies with an AES-GCM key derived from a secret.
# Generate one with: npx convex auth add-secret --name auth-secret --provider aes-gcm
# and store it in the Convex dashboard. DO NOT hardcode it here.
# AUTH_SECRET=...

# ---------------------------------------------------------------------------
# SMS delivery (Twilio or compatible provider) — server-side only
# ---------------------------------------------------------------------------
# Provider key: "twilio" (or leave unset → alerts are recorded as
# provider_not_configured instead of pretending to send).
SMS_PROVIDER=
SMS_ACCOUNT_ID=
SMS_AUTH_TOKEN=
SMS_FROM_NUMBER=

# ---------------------------------------------------------------------------
# Email delivery (Resend / SendGrid compatible) — server-side only
# ---------------------------------------------------------------------------
# Used for verification codes, password resets and emergency emails.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=alerts@ealert.example.com

# ---------------------------------------------------------------------------
# Maps (Google Maps / Mapbox) — optional; without a key the app shows a
# labeled map placeholder with coordinates.
# ---------------------------------------------------------------------------
MAP_PROVIDER=
MAP_API_KEY=

# ---------------------------------------------------------------------------
# Push notifications (Web Push / FCM) — reserved for future delivery
# ---------------------------------------------------------------------------
PUSH_PROVIDER=
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:alerts@ealert.example.com

# ---------------------------------------------------------------------------
# Test mode — safely disables external notifications
# ---------------------------------------------------------------------------
# When "true", emergency alerts are recorded but never dispatched to a real
# provider, and provider statuses report "demo". Always true in CI/tests.
EALERT_TEST_MODE=true
